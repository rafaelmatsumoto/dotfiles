#!/usr/bin/env bash
# Open personal notes and cheatsheet

set -e

NOTES_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

echo "Available notes:"
echo "1. README.md - Main documentation"
echo "2. AGENTS.md - AI agent configuration and workflows"
echo ""
echo "Select option (1-2) or 'a' for all: "

read -r choice

case $choice in
    1)
        if command -v bat &>/dev/null; then
            bat "$NOTES_DIR/README.md"
        else
            cat "$NOTES_DIR/README.md"
        fi
        ;;
    2)
        if command -v bat &>/dev/null; then
            bat "$NOTES_DIR/AGENTS.md"
        else
            cat "$NOTES_DIR/AGENTS.md"
        fi
        ;;
    a|A)
        echo "=== README.md ==="
        cat "$NOTES_DIR/README.md"
        echo ""
        echo "=== AGENTS.md ==="
        cat "$NOTES_DIR/AGENTS.md"
        ;;
    *)
        echo "Invalid choice"
        exit 1
        ;;
esac