#!/usr/bin/env bash

set -e

CONFIG="install.conf.yaml"
DOTBOT_DIR="dotbot"
DOTBOT_BIN="bin/dotbot"
BASEDIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

echo "=== Dotfiles Installation ==="
echo "Base directory: $BASEDIR"

cd "${BASEDIR}" || {
    echo "✗ Failed to change to base directory" >&2
    exit 1
}

echo "Initializing dotbot submodule..."
if git -C "${DOTBOT_DIR}" submodule sync --quiet --recursive; then
    echo "✓ Dotbot submodule synced"
else
    echo "✗ Failed to sync dotbot submodule" >&2
    exit 1
fi

echo "Updating dotbot submodule..."
if git submodule update --init --recursive "${DOTBOT_DIR}"; then
    echo "✓ Dotbot submodule updated"
else
    echo "✗ Failed to update dotbot submodule" >&2
    exit 1
fi

echo "Running dotbot with config: $CONFIG"
if "${BASEDIR}/${DOTBOT_DIR}/${DOTBOT_BIN}" -d "${BASEDIR}" -c "${CONFIG}" "${@}"; then
    echo "✓ Dotbot completed successfully"
else
    echo "✗ Dotbot failed" >&2
    exit 1
fi

echo "=== Installation Complete ==="
